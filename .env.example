# Copy to .env.local and fill in what you need. Everything is optional for local demo.

# Postgres (Neon). Leave empty to use a local PGlite database in ./.pglite.
# Required on Vercel (the Neon integration sets it). Tables: npm run db:migrate.
DATABASE_URL=

# Anthropic API key. Without it the AI runs in fallback (rule-based) mode.
ANTHROPIC_API_KEY=

# AI limits
AI_DAILY_BUDGET_USD=2
AI_CALLS_PER_SANDBOX_PER_HOUR=60
# Optional: model for reading CMR photos (default: Haiku 5.5, or Sonnet 5.5 if Haiku lacks image input)
AI_CMR_MODEL=

# Optional password protecting the whole demo
DEMO_PASSWORD=

# Map tiles (MapLibre style URLs, read in the browser)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_FALLBACK_URL=

# Public address of the app, used in client tracking links inside e-mail drafts
# (e.g. https://tms-ai-demo.vercel.app). Defaults to http://localhost:3000.
APP_URL=

# Simulation
SIM_DEFAULT_SPEED=10
SANDBOX_TTL_HOURS=24
SANDBOXES_PER_IP_PER_DAY=20

# Salt for hashing visitor IP addresses — set a long random value in production
SANDBOX_IP_SALT=change-me
